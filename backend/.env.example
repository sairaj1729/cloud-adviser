# Application Configuration
PROJECT_NAME="Cloud Advisor V1 Backend"
API_V1_STR="/api"
SECRET_KEY="replace_this_super_secret_jwt_signing_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="cloud_advisor"

# AWS Configuration (System defaults for cross-account AssumeRole testing)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Azure Configuration
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# GCP Configuration
GCP_PROJECT_ID=""

# AI recommendations. Providers are tried in this order; remaining unset is okay.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
