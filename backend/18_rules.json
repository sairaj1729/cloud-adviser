[
    {
        "rule_id": "AWS-EC2-001",
        "name": "Underutilized EC2 Instance",
        "description": "Flags a running EC2 instance with low average CPU utilization below 15%.",
        "provider": "aws",
        "resource_type": "compute_instance",
        "required_data": [
            "metrics.cpu_average"
        ],
        "lookback_window": {
            "value": 14,
            "unit": "days"
        },
        "conditions": {
            "logic": "AND",
            "items": [
                {
                    "field": "metrics.cpu_average",
                    "operator": "lt",
                    "threshold": 15.0
                },
                {
                    "field": "metrics.cpu_average",
                    "operator": "gt",
                    "threshold": 0.0
                }
            ]
        },
        "recommendation": {
            "type": "RIGHTSIZING_REVIEW",
            "action_template": "Review instance sizing and consider a smaller suitable instance type."
        },
        "savings_calculation": {
            "type": "ESTIMATED_PERCENTAGE",
            "percentage": 45.0
        },
        "severity": "medium",
        "status": "active",
        "provenance": "DERIVED"
    },
    {
