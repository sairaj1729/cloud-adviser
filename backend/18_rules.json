    {
        "rule_id": "AWS-EBS-001",
        "name": "Unattached EBS Volume",
        "description": "Flags an unattached EBS volume or snapshot retained without an active lifecycle policy.",
        "provider": "aws",
        "resource_type": "block_storage",
        "required_data": [
            "configuration.volume_type"
        ],
        "lookback_window": {
            "value": 1,
            "unit": "days"
        },
        "conditions": {
            "logic": "AND",
            "items": [
                {
                    "field": "configuration.volume_type",
                    "operator": "eq",
                    "threshold": "snapshot"
                }
            ]
        },
        "recommendation": {
            "type": "CLEANUP_REVIEW",
            "action_template": "Confirm the volume/snapshot is no longer needed and is backed up before deleting it."
        },
        "savings_calculation": {
            "type": "ESTIMATED_PERCENTAGE",
            "percentage": 100.0
        },
        "severity": "high",
        "status": "active",
        "provenance": "DERIVED"
    },
    {
        "rule_id": "AWS-EBS-002",
